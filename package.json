{
  "name": "shadowing",
  "version": "1.0.0",
  "description": "A calm Japanese shadowing practice app",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tools/caption-relay-worker/tsconfig.json",
    "test:e2e": "playwright test",
    "demo:generate": "node scripts/generate-demo.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "start:vinext:test": "vite preview --config vite.preview.config.ts --port 3001",
    "deploy:vinext": "npm run db:migrate:production && cf deploy --prebuilt",
    "test:d1:runtime": "node scripts/check-d1-runtime.mjs",
    "test:d1:migrations": "node scripts/check-d1-migrations.mjs",
    "db:migrate:local": "cf d1 migrations apply cf88fe7d-16bb-4f58-8839-2b27718a7847 --local --persist-to .cloudflare/state --dir migrations",
    "db:migrations:local": "cf d1 migrations list cf88fe7d-16bb-4f58-8839-2b27718a7847 --local --persist-to .cloudflare/state --dir migrations",
    "db:migrate:production": "cf d1 migrations apply cf88fe7d-16bb-4f58-8839-2b27718a7847 --dir migrations",
    "db:migrations:production": "cf d1 migrations list cf88fe7d-16bb-4f58-8839-2b27718a7847 --dir migrations",
    "caption-relay": "node --env-file=.env.caption-relay --import tsx scripts/caption-relay.ts",
    "build:caption-relay": "cd tools/caption-relay-worker && cf build",
    "deploy:caption-relay": "cd tools/caption-relay-worker && cf deploy --prebuilt",
    "check:youtube-browser": "node scripts/check-youtube-browser.mjs",
    "furigana:prepare": "node scripts/prepare-furigana.mjs",
    "lexicon:prepare": "node scripts/prepare-lexicon.mjs",
    "lexicon:update": "node scripts/prepare-lexicon.mjs --update",
    "predev": "npm run furigana:prepare && npm run lexicon:prepare",
    "prebuild": "npm run furigana:prepare && npm run lexicon:prepare",
    "predev:vinext": "npm run furigana:prepare && npm run lexicon:prepare",
    "prebuild:vinext": "npm run furigana:prepare && npm run lexicon:prepare",
    "format": "prettier --write src tests scripts tools *.ts *.js *.mjs *.json",
    "format:check": "prettier --check src tests scripts tools *.ts *.js *.mjs *.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulianPJ/Shadowing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JulianPJ/Shadowing/issues"
  },
  "homepage": "https://github.com/JulianPJ/Shadowing#readme",
  "devDependencies": {
    "@andresaya/edge-tts": "^1.8.1",
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.12",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "ffmpeg-static": "^5.3.0",
    "kuromoji": "0.1.2",
    "miniflare": "^5.20260930.0-alpha",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@vimeo/player": "^2.30.4",
    "@vinext/cloudflare": "^1.0.1",
    "better-auth": "1.7.7",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.1",
    "ws": "^8.22.0",
    "youtube-transcript-plus": "^2.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "workspaces": [
    "tools/caption-relay-worker"
  ]
}
