# Server-only caption provider settings. Leave unset for local direct retrieval.
# Production uses an authenticated relay.
# Set as Cloudflare secrets on the app; never prefix with NEXT_PUBLIC_.
# YOUTUBE_CAPTION_RELAY_URL=https://shadowing-caption-relay.julianpopovskijones.workers.dev
# YOUTUBE_CAPTION_RELAY_TOKEN=<random secret of at least 32 characters>

# The Node relay uses these same two settings in an ignored .env.caption-relay.
# The broker Worker needs only YOUTUBE_CAPTION_RELAY_TOKEN.

# Production comprehension generation uses the native Cloudflare Workers AI binding
# declared in cloudflare.config.ts. It requires no QUIZ_* API credentials.
# Local Next.js development can optionally use the generic OpenAI-compatible
# QUIZ_API_URL / QUIZ_API_KEY / QUIZ_MODEL environment variables.

# Server-only DeepL key for on-demand Japanese -> English translation.
# API Free keys end in :fx and automatically use api-free.deepl.com.
# Set this as a Cloudflare Worker secret in production; never expose it client-side.
# DEEPL_AUTH_KEY=<DeepL API authentication key>

# Optional accounts in standard Next.js development. Production values are Cloudflare secrets.
# AUTH_BASE_URL=http://localhost:3000
# Production canonical origin: https://hibikiapp.net (set via cloudflare.config.ts)
# AUTH_SECRET=<stable random secret of at least 32 characters>
# GOOGLE_CLIENT_ID=<existing Google OAuth web client ID>
# GOOGLE_CLIENT_SECRET=<Google OAuth secret>
# RESEND_API_KEY=<Resend send-only API key>
# AUTH_EMAIL_FROM=Hibiki <accounts@hibikiapp.net>  # after Resend domain verification
# Google callback: <AUTH_BASE_URL>/api/auth/callback/google
# Never use NEXT_PUBLIC_ for these settings. See docs/accounts-and-sync.md.

# Discover acquires metadata only in the Cloudflare Worker's scheduled job.
# Set as a server-only Worker secret with YouTube Data API enabled. See docs/discover.md.
# YOUTUBE_DATA_API_KEY=<YouTube Data API key>
# Optional build-time navigation rollback switch (Worker DISCOVER_ENABLED is separate):
# NEXT_PUBLIC_DISCOVER_ENABLED=false
