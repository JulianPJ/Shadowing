# Optional local own-media transcription:
# NEXT_PUBLIC_WHISPER_URL=http://127.0.0.1:8765

# Server-only caption provider settings. Leave unset for local direct retrieval.
# Production uses an authenticated relay because YouTube blocks Worker egress.
# Set as Cloudflare secrets on the app; never prefix with NEXT_PUBLIC_.
# YOUTUBE_CAPTION_RELAY_URL=https://shadowing-caption-relay.julianpopovskijones.workers.dev
# YOUTUBE_CAPTION_RELAY_TOKEN=<random secret of at least 32 characters>

# The Node relay uses these same two settings in an ignored .env.caption-relay.
# The broker Worker needs only YOUTUBE_CAPTION_RELAY_TOKEN.

# Optional server-only comprehension provider, using the chat-completions JSON API.
# Configure these as secrets on the Cloudflare app Worker. The demo needs none.
# QUIZ_API_URL=https://your-provider.example/v1/chat/completions
# QUIZ_API_KEY=<provider token>
# QUIZ_MODEL=<a model supporting JSON object responses>
